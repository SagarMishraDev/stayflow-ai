# StayFlow AI — example environment configuration.
# Copy to `.env` and fill in real values. Never commit a real `.env`.
APP_NAME=StayFlow AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

API_PREFIX=/api/v1

ALLOWED_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

# PostgreSQL connection URL (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://postgres:Your_Password@localhost:5432/stayflow

# --- Hotel staff JWT auth (Prompt-1 section 3) --------------------------------
# Secret used to sign staff JWTs. The built-in default is for local
# development only; set a strong random value here in production
# (the app refuses to start in production with the dev default).
JWT_SECRET_KEY=<redacted>
JWT_ALGORITHM=HS256
# Staff session lifetime in minutes.
JWT_EXPIRE_MINUTES=480

# --- AI agent layer -------------------------------------------------------
# LLM provider: "inception" (production default — Inception Labs Mercury via
# its OpenAI-compatible API), "ollama" (local LLM), or "mock" (deterministic,
# no LLM needed; explicit opt-in for tests/demos only — never rely on it in
# production). LLM_PROVIDER takes precedence; when unset, the legacy
# AGENT_PROVIDER applies.
LLM_PROVIDER=
AGENT_PROVIDER=inception
# Ollama model used when the provider is "ollama".
AGENT_MODEL=qwen3:8b
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_TIMEOUT_SECONDS=120
AGENT_TEMPERATURE=0.2
AGENT_MAX_ITERATIONS=8
AGENT_HISTORY_LIMIT=20
# Inception Labs Mercury, used when LLM_PROVIDER=inception.
# Never commit a real key; the key is sent only as a Bearer token and never logged.
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-2.5
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_TIMEOUT_SECONDS=120
# Retries on retryable Inception API errors (e.g. 429/5xx).
INCEPTION_MAX_RETRIES=2

# --- Knowledge RAG embeddings ------------------------------------------------
# Embedding backend for the hotel knowledge base:
#   "sentence-transformer" (default) — real semantic embeddings from a local
#       sentence-transformer model; the model downloads once (~90 MB) on
#       first use into the Hugging Face cache, then runs fully offline.
#   "hashed" — deterministic hashed bag-of-words, stdlib-only, no model
#       download (fast; used by the unit-test suite).
EMBEDDING_PROVIDER=sentence-transformer
# Local sentence-transformer model id (Hugging Face). Only used when
# EMBEDDING_PROVIDER=sentence-transformer.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Messaging bot connectors (Prompt-1 sections 4-5) ----------------------
# Telegram bot token from @BotFather. Replies are sent via the Bot HTTP API.
TELEGRAM_BOT_TOKEN=
# Secret token Telegram must send in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Twilio credentials for the WhatsApp connector.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio WhatsApp sender, e.g. whatsapp:+14155238886.
TWILIO_WHATSAPP_NUMBER=

# --- Rate limiting for public endpoints (Prompt-1 section 4) -----------------
# In-memory sliding-window limiter (Redis is only used for the arq job
# queue, not for rate limiting). Set RATE_LIMIT_ENABLED=false
# to disable (not recommended in production).
RATE_LIMIT_ENABLED=true
# POST /api/v1/agent/chat: per client IP (public guest_id is not a trusted rate-limit identity).
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
# POST /api/v1/webhooks/{telegram,whatsapp}/{hotel_id}: per sender identity
# (Telegram chat_id / WhatsApp From number), client IP fallback.
RATE_LIMIT_WEBHOOK_PER_MINUTE=30
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
# POST /api/v1/auth/login: per client IP + email (slows credential stuffing).
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# --- Background job queue (Prompt-1 section 6) --------------------------------
# Redis backs the arq queue used for slow operations (RAG document ingestion:
# chunking + embedding). The API enqueues jobs and answers 202 immediately;
# run the worker with: arq app.jobs.queue.WorkerSettings
# (Docker: the `worker` service in docker-compose.yml).
# Format: redis://[:password@]host[:port][/db]
REDIS_URL=redis://localhost:6379/0
# Synchronous fallback: ingest documents inline in the API process instead of
# enqueueing (single-process setups with no Redis). Default false: the API
# goes through the queue.
INGEST_JOBS_SYNC=false
